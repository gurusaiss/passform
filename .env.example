# =============================================================================
# High-Conversion Registration & Onboarding Platform: Environment Configuration
# =============================================================================

# --- PUBLIC CLIENT-SIDE VARIABLES (Exposed to browser) ---
# Canonical Production Domain (e.g. https://your-project.vercel.app or https://summit.example.com)
# Used for canonical SEO tags, QR code generation, and social share links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare Turnstile Public Site Key
# For local development testing, Cloudflare provides a test site key that always passes:
# 1x00000000000000000000AA (always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Supabase Project URL and Public Anon Key
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Default fallback WhatsApp invite URL (overridden by platform_settings if configured in DB)
NEXT_PUBLIC_DEFAULT_WHATSAPP_URL="https://chat.whatsapp.com/sampleInviteCode123"

# Google Analytics 4 Measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""


# --- PRIVATE SERVER-SIDE SECRETS (NEVER EXPOSE TO CLIENT) ---
# Supabase Service Role Secret Key (Bypasses RLS for secure server-side operations)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Cloudflare Turnstile Secret Key
# For local testing with 1x00000000000000000000AA, use:
# 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Admin Dashboard Access Passkey (Used to authenticate the /admin portal)
ADMIN_SECRET_KEY="change_this_to_a_secure_random_admin_password_in_production"

# Resend Transactional Email API Key (optional for Phase 1 testing)
# If left blank, registrations still succeed and confirmation email dispatch is safely skipped.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"


# --- PHASE 2 OPTIONAL: RAZORPAY INTEGRATION ---
# Set to 'true' only when activating paid ticket collection
ENABLE_PAYMENTS="false"
REGISTRATION_FEE_INR="499"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
